# Names only. Copy to .env and fill in. Never commit .env.

# development locally, production on Render. Tests refuse to run unless this is "development".
APP_ENV=
# Main Postgres (Neon) connection string. Migrations and the app use this.
DATABASE_URL=
# Separate Postgres database for e2e tests. Tests wipe it.
TEST_DATABASE_URL=
# Public URL of the web app (login redirects, email links).
APP_URL=

# Google OAuth client id.
GOOGLE_CLIENT_ID=
# Google OAuth client secret.
GOOGLE_CLIENT_SECRET=
# Where Google sends the user back: <host>/api/auth/google/callback
GOOGLE_CALLBACK_URL=
# Your email: seeded as the owner and receives the manual send-now email. Anyone with a verified Google account can sign in.
ALLOWED_EMAILS=
# Secret used to sign the login cookie (JWT).
JWT_SECRET=

# Cloudinary connection string for image uploads.
CLOUDINARY_URL=
# Resend API key for the Friday email.
RESEND_API_KEY=
# "From" address of the Friday email.
EMAIL_FROM=
# OpenRouter API key for the AI refine button.
OPENROUTER_API_KEY=
# Comma-separated OpenRouter model ids, tried in order.
OPENROUTER_MODELS=
# Comma-separated terms to redact before text is sent to the AI.
AI_REDACT_TERMS=

# PORT is set by Render in production; the API defaults to 3000.
